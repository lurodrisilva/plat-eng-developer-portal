# Keep the build context small and, more importantly, keep host state out of
# the image. `COPY . .` runs after `npm ci`, so anything listed here also
# protects the dependency layer's cache from unrelated edits.

.git
.github
node_modules
dist
graphify-out
.omc
.claude
.agents

# Local environment files. These carry a tenant's client id and would otherwise
# be baked into a bundle that is supposed to be environment-agnostic — the exact
# pinning slice P3 removed.
.env
.env.*
!.env.example

*.md
!README.md
.DS_Store
