# ---------------------------------------------------------------------------
# The four VITE_* values below are BUILD-TIME DEFAULTS for local development.
# They are not how a deployed portal is configured: the container renders
# /config.js from its own environment at start (scripts/docker-entrypoint.sh),
# and a key present there wins over anything baked here — see src/lib/config.ts.
# Same variable names on both sides, so what you set locally is what a
# ConfigMap sets in the cluster.
#
# None of them are secrets. A client id, an authority and a scope are public
# identifiers shipped to every browser that loads the page.
# ---------------------------------------------------------------------------

# VITE_ORCHESTRATOR_URL: Base URL of the platform orchestrator BFF, used by the
# create wizard to validate J3 tunable knobs (POST /api/v1/deployments:validate).
# Empty/unset => same-origin: the Vite dev proxy forwards /api to the target below.
VITE_ORCHESTRATOR_URL="http://localhost:8080"

# Microsoft Entra SPA sign-in (Phase F). Empty => mock mode (no real auth).
VITE_ENTRA_CLIENT_ID=""
VITE_ENTRA_AUTHORITY="https://login.microsoftonline.com/8f77fb2e-7e77-477e-9a03-d078b7aad9c3"
VITE_ENTRA_SCOPE="api://224ccefb-cfa7-42ba-9440-1f1b03aaca72/deploy"
